{
  "productName": "Flux",
  "version": "0.1.0",
  "identifier": "dev.flux.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Flux",
        "width": 1360,
        "height": 860,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Flux",
    "category": "GraphicsAndDesign",
    "shortDescription": "Audio-reactive video engine and node-graph compositor",
    "longDescription": "Flux is a Windows-first audio-reactive video engine: a wgpu renderer, a 217-entry node graph, exact rational timing and deterministic offline export, driven by a Rust core with a thin desktop front end.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
